# Postgres
POSTGRES_USER=airesearcher
POSTGRES_PASSWORD=airesearcher
POSTGRES_DB=airesearcher

# API (container-to-container URL; async driver)
DATABASE_URL=postgresql+asyncpg://airesearcher:airesearcher@postgres:5432/airesearcher

# CORS — comma-separated origins the API accepts browser requests from
CORS_ORIGINS=http://localhost:3000

# Object storage (MinIO in dev, S3-compatible)
S3_ACCESS_KEY=airesearcher
S3_SECRET_KEY=airesearcher-dev-secret
S3_BUCKET=airesearcher-documents
# container-to-container URL; MinIO console (browsable UI) is at :9001
S3_ENDPOINT_URL=http://minio:9000

# Web (browser-facing; must be host-reachable, not the Docker service name)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Embeddings — Voyage AI. Leave VOYAGE_API_KEY unset for local dev without
# a key: the app falls back to a deterministic but NOT semantically
# meaningful local embedder (see app/core/embeddings.py) so the pipeline
# still runs end-to-end. Set a real key for anything beyond mechanical
# testing — search quality is meaningless without it.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1024
