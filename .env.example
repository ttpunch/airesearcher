# Postgres
POSTGRES_USER=airesearcher
POSTGRES_PASSWORD=airesearcher
POSTGRES_DB=airesearcher

# API (container-to-container URL; async driver)
DATABASE_URL=postgresql+asyncpg://airesearcher:airesearcher@postgres:5432/airesearcher

# CORS — comma-separated origins the API accepts browser requests from
CORS_ORIGINS=http://localhost:3000

# Object storage (MinIO in dev, S3-compatible)
S3_ACCESS_KEY=airesearcher
S3_SECRET_KEY=airesearcher-dev-secret
S3_BUCKET=airesearcher-documents
# container-to-container URL; MinIO console (browsable UI) is at :9001
S3_ENDPOINT_URL=http://minio:9000

# Web (browser-facing; must be host-reachable, not the Docker service name)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Embeddings — Voyage AI. Leave VOYAGE_API_KEY unset for local dev without
# a key: the app falls back to a deterministic but NOT semantically
# meaningful local embedder (see app/core/embeddings.py) so the pipeline
# still runs end-to-end. Set a real key for anything beyond mechanical
# testing — search quality is meaningless without it.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1024

# Research agent (POST /api/ask, POST /api/research) model provider.
# LLM_PROVIDER=anthropic (default) uses the Claude Agent SDK and
# ANTHROPIC_API_KEY below — this is the primary, most-tested path (see
# AGENTS.md for why it's the default). Set LLM_PROVIDER=openrouter or
# LLM_PROVIDER=deepseek instead to run the same tools through a
# hand-rolled OpenAI-compatible tool-calling loop
# (app/agent/openai_compatible.py) against that provider's API instead —
# useful if you don't have an Anthropic key. Whichever provider is active,
# the endpoint fails when called without its key set; there is no local
# fallback for the agent loop itself, unlike embeddings.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

# Only used when LLM_PROVIDER=openrouter. Get a key at openrouter.ai —
# OPENROUTER_MODEL can be any model OpenRouter serves, not just DeepSeek's.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Only used when LLM_PROVIDER=deepseek (DeepSeek's API directly, not via
# OpenRouter). Get a key at platform.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# National Power Portal (npp.gov.in) integration — see app/portals/npp/.
# No API key needed: it's a plain, unauthenticated public dashboard.
# Defaults below are fine for normal use; override only to point at a
# different base URL (e.g. a local fixture server for testing) or disable
# it entirely.
NPP_ENABLED=true
NPP_BASE_URL=https://npp.gov.in
